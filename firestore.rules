rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    
    // 1. Users Collection
    match /users/{uid} {
      // Anyone can read a basic profile (needed for comments), but only owner can write
      allow read: if true;
      allow write: if isOwner(uid);
      
      // User Subcollections (History, Bookmarks, Interactions)
      // Strictly private to the user
      match /history/{postSlug} {
        allow read, write: if isOwner(uid);
      }
      match /bookmarks/{postSlug} {
        allow read, write: if isOwner(uid);
      }
      match /interactions/{postSlug} {
        allow read, write: if isOwner(uid);
      }
    }
    
    // 2. Posts Collection (Aggregates)
    match /posts/{postSlug} {
      // Anyone can read post aggregates
      allow read: if true;
      // Allow atomic increments only (+1 or -1) by authenticated users
      allow update: if isAuthenticated() 
                    && (request.resource.data.likesCount == resource.data.likesCount + 1 
                        || request.resource.data.likesCount == resource.data.likesCount - 1
                        || request.resource.data.upvotesCount == resource.data.upvotesCount + 1
                        || request.resource.data.upvotesCount == resource.data.upvotesCount - 1
                        || request.resource.data.downvotesCount == resource.data.downvotesCount + 1
                        || request.resource.data.downvotesCount == resource.data.downvotesCount - 1
                        || request.resource.data.viewsCount == resource.data.viewsCount + 1
                        || request.resource.data.commentsCount == resource.data.commentsCount + 1);
      allow create: if isAuthenticated(); // Allow creation of doc if first time interacted
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true; // Public can read comments
        // Only authenticated users can create, and authorUid must match their token
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        // Only comment author can update or delete
        allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }



    // -----------------------------------------------------------------------
    // Public website notification feed
    // -----------------------------------------------------------------------
    match /site_notifications/{notificationId} {
      allow get, list: if true;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Distribution Engine: public clients have no read/list/write access.
    // Firebase Admin SDK access is not evaluated by these rules.
    // -----------------------------------------------------------------------

    // FCM tokens are capability-bearing data. The browser can upsert only its
    // own token document and cannot read, enumerate, or delete token records.
    match /notification_tokens/{tokenId} {
      allow create: if validToken(request.resource.data);
      allow update: if validToken(request.resource.data)
        && request.resource.data.token == resource.data.token
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['browser', 'platform', 'language', 'last_used', 'active']);
      allow read, delete: if false;
    }

    // Signup is the only public subscriber operation. Verification and
    // unsubscribe use the token-addressed update below; collection queries
    // remain forbidden so subscriber data cannot be enumerated.
    match /subscribers/{subscriberToken} {
      allow create: if subscriberToken == request.resource.data.verification_token
        && validSubscriber(request.resource.data);
      allow update: if subscriberToken == resource.data.verification_token
        && subscriberToken == request.resource.data.verification_token
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['verified'])
            && request.resource.data.verified == true
            && request.resource.data.is_active == resource.data.is_active
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['is_active'])
            && request.resource.data.is_active == false
            && request.resource.data.verified == resource.data.verified
          )
        );
      allow read, delete: if false;
    }

    // Distribution queues, delivery history, and analytics are backend-only.
    match /daily_digest/{document=**} {
      allow read, write: if false;
    }

    match /daily_digest_queue/{document=**} {
      allow read, write: if false;
    }

    match /notification_history/{document=**} {
      allow read, write: if false;
    }

    match /distribution_metrics/{document=**} {
      allow read, write: if false;
    }

    match /analytics/{document=**} {
      allow read, write: if false;
    }

    // Default deny for every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
